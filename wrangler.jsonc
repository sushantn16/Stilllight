// Cloudflare Workers, static assets only: no Worker code runs. Serves iamsushant.dev/photos* (a route),
// and photos.iamsushant.dev, which only redirects there.
// Workers Builds runs `npm run build` and then `npx wrangler deploy` on every push to main.
// The build writes to site/photos/ so asset paths match the /photos/ URL prefix.
{
  "name": "stilllight",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./site"
  }
}
